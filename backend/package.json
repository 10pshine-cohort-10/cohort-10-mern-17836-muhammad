{
  "name": "noted-backend",
  "version": "1.0.0",
  "description": "Noted REST API and Socket.IO backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "cross-env NODE_ENV=test mocha --import=tsx \"tests/**/*.test.ts\" --exit",
    "test:coverage": "cross-env NODE_ENV=test nyc --reporter=lcov --reporter=text mocha --import=tsx \"tests/**/*.test.ts\" --exit"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "sanitize-html": "^2.13.1",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/chai": "^4.3.19",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.9.0",
    "@types/sanitize-html": "^2.13.0",
    "@types/sinon": "^17.0.3",
    "@types/uuid": "^10.0.0",
    "chai": "^4.4.1",
    "cross-env": "^7.0.3",
    "mocha": "^10.7.3",
    "nyc": "^17.1.0",
    "sinon": "^18.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
